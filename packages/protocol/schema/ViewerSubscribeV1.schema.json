{
  "$defs": {
    "ViewerCursorV1": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "format": "uint64-decimal",
          "pattern": "^(?:[1-9][0-9]{0,19})$",
          "title": "Epoch",
          "type": "string"
        },
        "next_seq": {
          "format": "uint64-decimal",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$",
          "title": "Next Seq",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "epoch",
        "next_seq"
      ],
      "title": "ViewerCursorV1",
      "type": "object"
    }
  },
  "$id": "https://livecho.invalid/protocol/v1/ViewerSubscribeV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_version": {
      "maxLength": 64,
      "minLength": 5,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?$",
      "title": "Client Version",
      "type": "string"
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ViewerCursorV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Message Id",
      "type": "string"
    },
    "protocol": {
      "const": "livecho.viewer.v1",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_minor": {
      "const": 0,
      "title": "Protocol Minor",
      "type": "integer"
    },
    "room_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Room Id",
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Sent At",
      "type": "string"
    },
    "supported_minors": {
      "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Supported Minors",
      "type": "array",
      "uniqueItems": true
    },
    "type": {
      "const": "viewer.subscribe",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "protocol_minor",
    "message_id",
    "type",
    "sent_at",
    "client_version",
    "supported_minors",
    "room_id"
  ],
  "title": "ViewerSubscribeV1",
  "type": "object"
}
