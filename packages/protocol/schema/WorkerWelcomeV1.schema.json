{
  "$defs": {
    "ModelManifestRefV1": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Revision",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model_id",
        "revision",
        "sha256"
      ],
      "title": "ModelManifestRefV1",
      "type": "object"
    }
  },
  "$id": "https://livecho.invalid/protocol/v1/WorkerWelcomeV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_capabilities": {
      "items": {
        "enum": [
          "asr.transcribe",
          "protocol.binary-pcm"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Accepted Capabilities",
      "type": "array",
      "uniqueItems": true
    },
    "accepted_manifests": {
      "items": {
        "$ref": "#/$defs/ModelManifestRefV1"
      },
      "maxItems": 16,
      "title": "Accepted Manifests",
      "type": "array",
      "uniqueItems": true
    },
    "connection_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Connection Id",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Message Id",
      "type": "string"
    },
    "minimum_worker_version": {
      "const": "0.1.0",
      "title": "Minimum Worker Version",
      "type": "string"
    },
    "protocol": {
      "const": "livecho.worker.v1",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_minor": {
      "const": 0,
      "title": "Protocol Minor",
      "type": "integer"
    },
    "resume_succeeded": {
      "title": "Resume Succeeded",
      "type": "boolean"
    },
    "selected_minor": {
      "const": 0,
      "title": "Selected Minor",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Sent At",
      "type": "string"
    },
    "type": {
      "const": "worker.welcome",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "protocol_minor",
    "message_id",
    "type",
    "sent_at",
    "connection_id",
    "selected_minor",
    "minimum_worker_version",
    "resume_succeeded",
    "accepted_capabilities",
    "accepted_manifests"
  ],
  "title": "WorkerWelcomeV1",
  "type": "object"
}
