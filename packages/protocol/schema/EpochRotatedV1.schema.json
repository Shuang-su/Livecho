{
  "$id": "https://livecho.invalid/protocol/v1/EpochRotatedV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closed_epoch": {
      "format": "uint64-decimal",
      "pattern": "^(?:[1-9][0-9]{0,19})$",
      "title": "Closed Epoch",
      "type": "string"
    },
    "lease_id": {
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
      "title": "Lease Id",
      "type": "string"
    },
    "media_continue_ms": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Media Continue Ms",
      "type": "integer"
    },
    "message_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Message Id",
      "type": "string"
    },
    "opened_epoch": {
      "format": "uint64-decimal",
      "pattern": "^(?:[1-9][0-9]{0,19})$",
      "title": "Opened Epoch",
      "type": "string"
    },
    "pcm_continue_pts": {
      "format": "uint64-decimal",
      "pattern": "^(?:0|[1-9][0-9]{0,19})$",
      "title": "Pcm Continue Pts",
      "type": "string"
    },
    "protocol": {
      "const": "livecho.worker.v1",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_minor": {
      "const": 1,
      "title": "Protocol Minor",
      "type": "integer"
    },
    "reason": {
      "enum": [
        "revision_capacity",
        "lease_replaced"
      ],
      "title": "Reason",
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Sent At",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "worker.epoch_rotated",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "protocol_minor",
    "message_id",
    "type",
    "sent_at",
    "session_id",
    "lease_id",
    "closed_epoch",
    "opened_epoch",
    "media_continue_ms",
    "pcm_continue_pts",
    "reason"
  ],
  "title": "EpochRotatedV1",
  "type": "object"
}
