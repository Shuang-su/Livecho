{
  "$id": "https://livecho.invalid/protocol/v1/ProtocolErrorV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "malformed_json",
        "duplicate_key",
        "unknown_field",
        "schema_invalid",
        "control_frame_too_large",
        "unknown_major",
        "unsupported_minor",
        "worker_version_too_old",
        "capability_required",
        "manifest_not_allowed",
        "lease_unknown",
        "lease_expired",
        "lease_closed",
        "binding_mismatch",
        "epoch_stale",
        "epoch_unknown",
        "seq_conflict",
        "seq_gap",
        "revision_conflict",
        "revision_stale",
        "revision_gap",
        "revision_immutable",
        "revision_capacity_exceeded",
        "cancel_conflict",
        "object_final",
        "resync_required",
        "binary_header_invalid",
        "binary_frame_too_large",
        "audio_pts_invalid",
        "audio_budget_exceeded"
      ],
      "title": "Code",
      "type": "string"
    },
    "expected": {
      "anyOf": [
        {
          "format": "uint64-decimal",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected"
    },
    "message": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Message Id",
      "type": "string"
    },
    "protocol": {
      "enum": [
        "livecho.worker.v1",
        "livecho.viewer.v1"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "protocol_minor": {
      "const": 0,
      "title": "Protocol Minor",
      "type": "integer"
    },
    "received": {
      "anyOf": [
        {
          "format": "uint64-decimal",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Received"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "sent_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Sent At",
      "type": "string"
    },
    "type": {
      "const": "protocol.error",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "protocol_minor",
    "message_id",
    "type",
    "sent_at",
    "code",
    "message",
    "retryable"
  ],
  "title": "ProtocolErrorV1",
  "type": "object"
}
