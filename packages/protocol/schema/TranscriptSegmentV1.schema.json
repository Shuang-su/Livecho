{
  "$id": "https://livecho.invalid/protocol/v1/TranscriptSegmentV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "end_ms": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "epoch": {
      "format": "uint64-decimal",
      "pattern": "^(?:[1-9][0-9]{0,19})$",
      "title": "Epoch",
      "type": "string"
    },
    "is_final": {
      "title": "Is Final",
      "type": "boolean"
    },
    "language": {
      "anyOf": [
        {
          "maxLength": 35,
          "minLength": 2,
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "lease_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Lease Id",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Message Id",
      "type": "string"
    },
    "protocol": {
      "const": "livecho.worker.v1",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_minor": {
      "const": 0,
      "title": "Protocol Minor",
      "type": "integer"
    },
    "revision": {
      "format": "uint64-decimal",
      "pattern": "^(?:[1-9][0-9]{0,19})$",
      "title": "Revision",
      "type": "string"
    },
    "segment_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Segment Id",
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Sent At",
      "type": "string"
    },
    "seq": {
      "format": "uint64-decimal",
      "pattern": "^(?:0|[1-9][0-9]{0,19})$",
      "title": "Seq",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "start_ms": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "type": {
      "const": "worker.transcript",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "protocol_minor",
    "message_id",
    "type",
    "sent_at",
    "lease_id",
    "session_id",
    "segment_id",
    "epoch",
    "seq",
    "revision",
    "start_ms",
    "end_ms",
    "text",
    "is_final"
  ],
  "title": "TranscriptSegmentV1",
  "type": "object"
}
