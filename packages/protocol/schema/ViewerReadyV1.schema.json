{
  "$id": "https://livecho.invalid/protocol/v1/ViewerReadyV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor_resumed": {
      "title": "Cursor Resumed",
      "type": "boolean"
    },
    "epoch": {
      "format": "uint64-decimal",
      "pattern": "^(?:[1-9][0-9]{0,19})$",
      "title": "Epoch",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Message Id",
      "type": "string"
    },
    "minimum_client_version": {
      "const": "0.1.0",
      "title": "Minimum Client Version",
      "type": "string"
    },
    "next_seq": {
      "format": "uint64-decimal",
      "pattern": "^(?:0|[1-9][0-9]{0,19})$",
      "title": "Next Seq",
      "type": "string"
    },
    "protocol": {
      "const": "livecho.viewer.v1",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_minor": {
      "const": 0,
      "title": "Protocol Minor",
      "type": "integer"
    },
    "selected_minor": {
      "const": 0,
      "title": "Selected Minor",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Sent At",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "viewer.ready",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "protocol_minor",
    "message_id",
    "type",
    "sent_at",
    "selected_minor",
    "minimum_client_version",
    "session_id",
    "epoch",
    "next_seq",
    "cursor_resumed"
  ],
  "title": "ViewerReadyV1",
  "type": "object"
}
