{
  "$defs": {
    "ModelManifestRefV1": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Revision",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model_id",
        "revision",
        "sha256"
      ],
      "title": "ModelManifestRefV1",
      "type": "object"
    },
    "WorkerResumeV1": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Connection Id",
          "type": "string"
        },
        "epoch": {
          "format": "uint64-decimal",
          "pattern": "^(?:[1-9][0-9]{0,19})$",
          "title": "Epoch",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Lease Id",
          "type": "string"
        },
        "next_input_seq": {
          "format": "uint64-decimal",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$",
          "title": "Next Input Seq",
          "type": "string"
        },
        "next_output_seq": {
          "format": "uint64-decimal",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$",
          "title": "Next Output Seq",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "lease_id",
        "session_id",
        "epoch",
        "next_input_seq",
        "next_output_seq"
      ],
      "title": "WorkerResumeV1",
      "type": "object"
    }
  },
  "$id": "https://livecho.invalid/protocol/v1/WorkerHelloV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "enum": [
          "asr.transcribe",
          "protocol.binary-pcm"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array",
      "uniqueItems": true
    },
    "message_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Message Id",
      "type": "string"
    },
    "model_manifests": {
      "items": {
        "$ref": "#/$defs/ModelManifestRefV1"
      },
      "maxItems": 16,
      "title": "Model Manifests",
      "type": "array",
      "uniqueItems": true
    },
    "protocol": {
      "const": "livecho.worker.v1",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_minor": {
      "const": 0,
      "title": "Protocol Minor",
      "type": "integer"
    },
    "resume": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerResumeV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sent_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Sent At",
      "type": "string"
    },
    "supported_minors": {
      "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Supported Minors",
      "type": "array",
      "uniqueItems": true
    },
    "type": {
      "const": "worker.hello",
      "title": "Type",
      "type": "string"
    },
    "worker_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Worker Id",
      "type": "string"
    },
    "worker_version": {
      "maxLength": 64,
      "minLength": 5,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?$",
      "title": "Worker Version",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "protocol_minor",
    "message_id",
    "type",
    "sent_at",
    "worker_id",
    "worker_version",
    "supported_minors",
    "capabilities",
    "model_manifests"
  ],
  "title": "WorkerHelloV1",
  "type": "object"
}
