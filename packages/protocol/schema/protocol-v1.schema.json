        "protocol_minor": {
          "const": 0,
          "title": "Protocol Minor",
          "type": "integer"
        },
        "revision": {
          "format": "uint64-decimal",
          "pattern": "^(?:[1-9][0-9]{0,19})$",
          "title": "Revision",
          "type": "string"
        },
        "room_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "title": "Room Id",
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Sent At",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "type": {
