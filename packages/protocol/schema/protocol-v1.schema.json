          "type": "integer"
        },
        "reason": {
          "enum": [
            "operator_stop",
            "lease_expired",
            "worker_replaced",
            "policy_disable",
            "protocol_violation",
            "session_end"
          ],
          "title": "Reason",
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Sent At",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "worker.lease_cancel",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "protocol_minor",
        "message_id",
        "type",
        "sent_at",
        "lease_id",
        "session_id",
        "epoch",
        "expected_revision",
        "reason"
      ],
      "title": "LeaseCancelV1",
      "type": "object"
    },
    "LeaseV1": {
