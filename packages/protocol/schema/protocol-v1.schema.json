    "TranscriptSegmentV1": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_ms": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "epoch": {
          "format": "uint64-decimal",
          "pattern": "^(?:[1-9][0-9]{0,19})$",
          "title": "Epoch",
          "type": "string"
        },
        "is_final": {
          "title": "Is Final",
          "type": "boolean"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 35,
              "minLength": 2,
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
