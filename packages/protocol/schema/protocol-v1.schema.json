      "required": [
        "protocol",
        "protocol_minor",
        "message_id",
        "type",
        "sent_at",
        "lease_id",
        "session_id",
        "room_id",
        "epoch",
        "revision",
        "issued_at",
        "expires_at",
        "input_start_seq",
